{
  "js/ts.experimental.useTsgo": false,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "biome.enabled": false,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
    "node_modules": true,
    "dist": true,
    ".astro": true,
    "tsconfig.tsbuildinfo": true
  },
  "files.associations": {
    "**/styles/*.css": "tailwindcss"
  }
}
