---
interface Props {
  seed: string;
  bars?: number;
  barWidth?: number;
  animated?: boolean;
  class?: string;
}

const { seed, bars = 24, barWidth = 6, animated = false, class: className } = Astro.props;

// Hauteurs déterministes: chaque épisode garde la même empreinte sonore.
let state = 2166136261;
for (const char of seed) state = Math.imul(state ^ char.charCodeAt(0), 16777619) >>> 0;
const next = () => {
  state = (Math.imul(state, 1664525) + 1013904223) >>> 0;
  return state / 4294967296;
};
const count = Math.max(4, Math.min(120, Math.floor(bars)));
const raw = Array.from({ length: count }, () => next());
// Lissage des voisins: évite les pics isolés et donne une forme de voix plus naturelle.
const items = raw.map((_, i) => {
  const smooth = (raw[i - 1] ?? raw[i]) * 0.25 + raw[i] * 0.5 + (raw[i + 1] ?? raw[i]) * 0.25;
  const envelope = 0.35 + 0.65 * Math.sin((Math.PI * (i + 0.5)) / count) ** 0.7;
  return {
    height: Math.min(
      100,
      Math.round(28 + 72 * (0.3 + 0.7 * smooth) * (0.6 + 0.4 * envelope) * 1.15),
    ),
    duration: (1.6 + next() * 0.7).toFixed(2),
    low: (0.3 + next() * 0.3).toFixed(2),
  };
});
---

<div
  class:list={["waveform", animated && "waveform-animated", className]}
  style={`--bar:${barWidth}px`}
  data-dense={count > 32 ? "" : undefined}
  aria-hidden="true"
>
  {items.map((item, i) => (
    <span style={`--h:${item.height}%;--d:${item.duration}s;--lo:${item.low};--i:${i}`} />
  ))}
</div>

<style>
  .waveform {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3px;
    min-width: 0;
    container-type: inline-size;
  }
  .waveform > span {
    flex: 1 1 0;
    min-width: 3px;
    max-width: var(--bar);
    height: var(--h);
    border-radius: 9999px;
    background: currentColor;
  }
  /* Les formes denses perdent des barres quand la place manque. */
  @container (max-width: 1100px) {
    .waveform[data-dense] > span:nth-child(even) {
      display: none;
    }
  }
  @container (max-width: 520px) {
    .waveform[data-dense] > span:nth-child(4n + 3) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .waveform-animated > span {
      animation:
        wave-in 800ms cubic-bezier(0.2, 0.8, 0.2, 1) calc(var(--i) * 14ms) both,
        wave-breathe var(--d) ease-in-out calc(var(--i) * 14ms) infinite;
    }
  }
  @keyframes wave-in {
    from {
      transform: scaleY(0.05);
    }
  }
  @keyframes wave-breathe {
    50% {
      transform: scaleY(var(--lo));
    }
  }
</style>
