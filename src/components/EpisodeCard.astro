---
import type { CollectionEntry } from "astro:content";
import { formatDate, href } from "../lib/site";
import Waveform from "./Waveform.astro";

interface Props {
  episode: CollectionEntry<"episodes">;
  headingLevel?: "h2" | "h3";
}

const { episode, headingLevel: Heading = "h3" } = Astro.props;
const { title, description, pubDate, episodeNumber, spotifyId, youtubeUrl } = episode.data;
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-3xl border-2 border-black bg-white transition-transform has-[a:focus-visible]:outline-3 has-[a:focus-visible]:outline-offset-4 hover:-translate-y-1 motion-reduce:transition-none"
  style="box-shadow: 0.375rem 0.375rem 0 var(--color-brand)"
>
  <div class="border-b-2 border-black bg-sky px-5 pb-5 pt-5 text-brand">
    <p class="m-0 mb-4">
      <span class="tag">{episodeNumber ? `Épisode ${episodeNumber}` : "Épisode"}</span>
    </p>
    <Waveform seed={episode.id} bars={22} barWidth={6} class="h-14 w-full" />
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <Heading class="m-0 text-2xl">
      <a
        class="text-black no-underline after:absolute after:inset-0 after:content-[''] focus-visible:shadow-none focus-visible:outline-0"
        href={href(`podcasts/${episode.id}/`)}
      >
        {title}
      </a>
    </Heading>
    <p class="m-0 line-clamp-3">{description}</p>
    <p class="m-0 mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-2 text-base">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      {spotifyId && <span class="rounded-md border-2 border-black px-2 font-bold">Audio</span>}
      {youtubeUrl && <span class="rounded-md border-2 border-black px-2 font-bold">Vidéo</span>}
    </p>
  </div>
</article>
