---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Le site de l’association Culture accessible." } = Astro.props;

import "../styles/global.css";
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title} — Culture accessible</title>
  </head>
  <body class="mx-auto max-w-6xl px-6">
    <a
      class="absolute left-2 top-2 translate-y-[-150%] bg-white px-4 py-2 focus:translate-y-0"
      href="#contenu"
    >
      Aller au contenu
    </a>
    <header class="flex flex-wrap items-center justify-between gap-4 border-b border-slate-400 py-4">
      <a class="font-bold" href={import.meta.env.BASE_URL}>
        Culture accessible
      </a>
      <nav class="flex flex-wrap gap-4" aria-label="Navigation principale">
        <a href={import.meta.env.BASE_URL}>Accueil</a>
        <a href={`${import.meta.env.BASE_URL}articles/`}>Articles</a>
        <a href={`${import.meta.env.BASE_URL}podcasts/`}>Podcasts et vidéos</a>
      </nav>
    </header>
    <main class="min-h-[60vh] py-12" id="contenu">
      <slot />
    </main>
    <footer class="border-t border-slate-400 py-4">
      <p>Culture accessible</p>
    </footer>
    <script is:inline>
      if (!localStorage.getItem("accessibilityWidgetLanguage")) {
        localStorage.setItem("accessibilityWidgetLanguage", "fr");
      }
      window.ACCESSIBILITY_WIDGET_CONFIG = { enableVoiceControl: false };
    </script>
    <script>
      import "accessibility-widgets";
    </script>
  </body>
</html>
