---
import "../styles/global.css";
import ExternalLink from "../components/ExternalLink.astro";
import { LINKS, NAV, SITE_NAME, href } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = "Culture Accessible est un podcast consacré aux questions d’accessibilité dans le milieu culturel.",
  noindex = false,
  jsonLd,
} = Astro.props;

const pageTitle = title ? `${title} - ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(href("logo.png"), Astro.site).href;
const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE_NAME,
  url: new URL(href(), Astro.site).href,
  inLanguage: "fr-FR",
};
const currentPath = Astro.url.pathname;
const isCurrent = (path: string) => {
  const target = href(path);
  return path === "" ? currentPath === target : currentPath.startsWith(target);
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6b1fad" />
    <link rel="icon" type="image/png" href={href("favicon.png")} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      class="absolute left-3 top-3 z-50 -translate-y-24 rounded-full bg-black px-5 py-3 font-bold text-white focus:translate-y-0"
      href="#contenu"
    >
      Aller au contenu
    </a>

    <header class="border-b-2 border-black bg-white">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-4 sm:gap-x-8 sm:px-6">
        <a class="flex items-center gap-2 text-black no-underline sm:gap-3" href={href()}>
          <img src={href("logo-small.png")} alt="" width="40" height="40" class="h-10 w-10" />
          <span class="whitespace-nowrap text-base font-bold tracking-tight sm:text-xl">
            {SITE_NAME}
          </span>
        </a>
        <button
          id="menu-toggle"
          type="button"
          hidden
          class="inline-flex items-center gap-2 rounded-full border-2 border-black bg-white px-3 py-2 font-semibold text-black sm:px-4 md:hidden"
          aria-expanded="false"
          aria-controls="menu-principal"
        >
          <svg
            aria-hidden="true"
            width="20"
            height="20"
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <path d="M3 5h14M3 10h14M3 15h14"></path>
          </svg>
          <span class="sr-only sm:not-sr-only">Menu</span>
        </button>
        <nav id="menu-principal" class="w-full md:w-auto" aria-label="Navigation principale">
          <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-1 p-0 font-semibold max-md:flex-col">
            {NAV.map((item) => (
              <li>
                <a
                  class:list={[
                    "inline-block py-2 text-black no-underline decoration-brand decoration-4 underline-offset-8 hover:underline",
                    isCurrent(item.path) && "underline",
                  ]}
                  href={href(item.path)}
                  aria-current={isCurrent(item.path) ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenu" class="flex-1" tabindex="-1">
      <slot />
    </main>

    <footer class="on-dark border-t-2 border-black bg-brand text-white">
      <div class="mx-auto grid max-w-6xl gap-10 px-6 py-12 md:grid-cols-[1.2fr_1fr_1fr]">
        <div>
          <p class="m-0 flex items-center gap-3 text-xl font-bold">
            <img
              src={href("logo-small.png")}
              alt=""
              width="40"
              height="40"
              class="h-10 w-10 border-2 border-white"
            />
            {SITE_NAME}
          </p>
          <p class="mt-3 max-w-xs text-base">Pour une culture de l’accessible.</p>
        </div>
        <nav aria-label="Navigation du pied de page">
          <p class="m-0 text-xl font-bold">Le site</p>
          <ul class="m-0 mt-3 list-none space-y-1 p-0">
            {NAV.map((item) => (
              <li>
                <a class="inline-block py-1 text-white" href={href(item.path)}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div>
          <p class="m-0 text-xl font-bold">Nous suivre</p>
          <ul class="m-0 mt-3 list-none space-y-1 p-0">
            <li>
              <ExternalLink class="inline-block py-1 text-white" href={LINKS.listen}>
                Plateformes d’écoute
              </ExternalLink>
            </li>
            <li>
              <ExternalLink class="inline-block py-1 text-white" href={LINKS.instagram}>
                Instagram
              </ExternalLink>
            </li>
            <li>
              <ExternalLink class="inline-block py-1 text-white" href={LINKS.linkedin}>
                LinkedIn
              </ExternalLink>
            </li>
          </ul>
        </div>
      </div>
    </footer>

    <script is:inline>
      (() => {
        const toggle = document.getElementById("menu-toggle");
        const menu = document.getElementById("menu-principal");
        if (!toggle || !menu) return;
        toggle.hidden = false;
        menu.classList.add("max-md:hidden");
        const set = (open) => {
          menu.classList.toggle("max-md:hidden", !open);
          toggle.setAttribute("aria-expanded", String(open));
        };
        toggle.addEventListener("click", () =>
          set(toggle.getAttribute("aria-expanded") !== "true"),
        );
        document.addEventListener("keydown", (e) => {
          if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
            set(false);
            toggle.focus();
          }
        });
      })();
    </script>
    <script is:inline>
      if (!localStorage.getItem("accessibilityWidgetLanguage")) {
        localStorage.setItem("accessibilityWidgetLanguage", "fr");
      }
      window.ACCESSIBILITY_WIDGET_CONFIG = { enableVoiceControl: false };
    </script>
    <script>
      import "accessibility-widgets";
    </script>
  </body>
</html>
