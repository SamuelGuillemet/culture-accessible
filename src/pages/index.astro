---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";

const articles = (await getCollection("articles", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const episodes = (await getCollection("episodes", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<SiteLayout title="Accueil">
  <h1>Culture accessible</h1>
  <p>Le site de l’association est en préparation.</p>
  <p>Merci de votre patience.</p>

  <section class="mt-10" aria-labelledby="articles-recents">
    <h2 id="articles-recents">Derniers articles</h2>
    {articles.length ? (
      <ul class="list-none space-y-4 p-0">
        {articles.map((article) => (
          <li>
            <a class="font-semibold" href={`${import.meta.env.BASE_URL}articles/${article.id}/`}>
              {article.data.title}
            </a>
            <p>{article.data.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p>Aucun article publié pour le moment.</p>
    )}
  </section>

  <section class="mt-10" aria-labelledby="derniers-podcasts">
    <h2 id="derniers-podcasts">Derniers podcasts et vidéos</h2>
    {episodes.length ? (
      <ul class="list-none space-y-4 p-0">
        {episodes.map((episode) => (
          <li>
            <a class="font-semibold" href={`${import.meta.env.BASE_URL}podcasts/${episode.id}/`}>
              {episode.data.title}
            </a>
            <p>{episode.data.description}</p>
          </li>
        ))}
      </ul>
    ) : (
      <p>Aucun podcast publié pour le moment.</p>
    )}
  </section>
</SiteLayout>
