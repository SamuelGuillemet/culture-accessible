---
import ExternalLink from "../components/ExternalLink.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { LINKS } from "../lib/site";

const embedUrl = `${LINKS.contactForm}?embedded=true`;
---

<SiteLayout
  title="Contact"
  description="Écrivez-nous pour proposer un sujet, poser une question ou participer à Culture accessible."
>
  <section class="border-b-2 border-black bg-sky">
    <div class="mx-auto max-w-6xl px-6 py-14 sm:py-20">
      <h1 class="m-0 text-4xl sm:text-6xl">Contact</h1>
      <p class="mt-5 max-w-2xl text-xl">
        Vous souhaitez participer au podcast, proposer un sujet ou nous poser une question ?
        Remplissez le formulaire, nous vous répondrons.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-14" aria-labelledby="formulaire">
    <h2 id="formulaire" class="m-0 mb-4 text-2xl sm:text-3xl">
      Formulaire de contact
    </h2>
    <p class="mt-0 max-w-2xl">
      Le formulaire ne s’affiche pas bien ?{" "}
      <ExternalLink href={LINKS.contactForm}>Ouvrez-le dans un nouvel onglet</ExternalLink>.
    </p>
    <iframe
      class="mt-6 h-300 w-full rounded-3xl border-2 border-black bg-white"
      src={embedUrl}
      title="Formulaire de contact Culture accessible"
      loading="lazy"
    >
      Chargement du formulaire…
    </iframe>
  </section>
</SiteLayout>
