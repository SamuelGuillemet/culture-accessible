---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { withBaseForPublicMedia } from "../../lib/public-media-url.js";

export async function getStaticPaths() {
  const articles = await getCollection("articles", ({ data }) => !data.draft);
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const imageUrl = withBaseForPublicMedia(entry.data.image, import.meta.env.BASE_URL);
---

<SiteLayout title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-3xl">
    <h1>{entry.data.title}</h1>
    <p>{entry.data.description}</p>
    <p class="text-slate-700">
      Par {entry.data.author} ·
      <time datetime={entry.data.pubDate.toISOString()}>
        {entry.data.pubDate.toLocaleDateString("fr-FR", {
          dateStyle: "long",
          timeZone: "UTC",
        })}
      </time>
    </p>
    {imageUrl && <img src={imageUrl} alt={entry.data.imageAlt ?? ""} loading="lazy" />}
    <Content />
  </article>
</SiteLayout>
