---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const articles = (await getCollection("articles", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout title="Articles">
  <h1>Articles</h1>
  {articles.length ? (
    <ul class="list-none space-y-6 p-0">
      {articles.map((article) => (
        <li class="border-b border-slate-200 pb-6">
          <article>
            <h2 class="mt-0">
              <a href={`/articles/${article.id}/`}>{article.data.title}</a>
            </h2>
            <p>{article.data.description}</p>
            <p>
              <time datetime={article.data.pubDate.toISOString()}>
                {article.data.pubDate.toLocaleDateString("fr-FR", {
                  dateStyle: "long",
                  timeZone: "UTC",
                })}
              </time>
            </p>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <p>Aucun article publié pour le moment.</p>
  )}
</SiteLayout>
