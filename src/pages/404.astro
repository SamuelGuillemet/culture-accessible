---
import SiteLayout from "../layouts/SiteLayout.astro";
import { href } from "../lib/site";
---

<SiteLayout title="Page introuvable">
  <section class="mx-auto max-w-6xl px-6 py-24">
    <h1 class="m-0 text-4xl sm:text-6xl">Cette page n’existe pas.</h1>
    <p class="mt-5 max-w-2xl text-xl">
      Le lien est peut-être ancien. Retrouvez nos contenus depuis l’accueil.
    </p>
    <p class="mt-8">
      <a class="btn btn-primary" href={href()}>
        Retour à l’accueil
      </a>
    </p>
  </section>
</SiteLayout>
