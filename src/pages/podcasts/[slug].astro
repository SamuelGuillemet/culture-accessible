---
import { getCollection, render } from "astro:content";
import ResourceItem from "../../components/ResourceItem.astro";
import SpotifyPlayer from "../../components/SpotifyPlayer.astro";
import Waveform from "../../components/Waveform.astro";
import YoutubePlayer from "../../components/YoutubePlayer.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { parseYoutubeId } from "../../lib/media";
import { formatDate, href } from "../../lib/site";

export async function getStaticPaths() {
  const episodes = await getCollection("episodes", ({ data }) => !data.draft);
  const resources = await getCollection("resources", ({ data }) => !data.draft);
  return episodes.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      related: resources.filter((resource) => resource.data.episode?.id === entry.id),
    },
  }));
}

const { entry, related } = Astro.props;
const { title, description, pubDate, episodeNumber, spotifyId, youtubeUrl } = entry.data;
const { Content } = await render(entry);
const youtubeId = youtubeUrl ? parseYoutubeId(youtubeUrl) : undefined;
const hasTranscript = Boolean(entry.body?.trim());
---

<SiteLayout title={title} description={description}>
  <article>
    <header class="border-b-2 border-black bg-sky text-brand">
      <div class="mx-auto max-w-6xl px-6 pb-6 pt-12">
        <p class="m-0">
          <a class="font-semibold" href={href("podcasts/")}>
            Tous les épisodes
          </a>
        </p>
        <p class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-1 text-black">
          <span class="tag">{episodeNumber ? `Épisode ${episodeNumber}` : "Épisode"}</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </p>
        <h1 class="m-0 mt-4 max-w-4xl text-4xl text-black sm:text-6xl">{title}</h1>
        <p class="mt-5 max-w-2xl text-xl text-black">{description}</p>
        <Waveform seed={entry.id} bars={72} barWidth={6} class="mt-8 h-16 w-full" />
      </div>
    </header>

    <div class="mx-auto grid max-w-6xl gap-12 px-6 py-14">
      <section aria-labelledby="ecouter" class="max-w-3xl">
        <h2 id="ecouter" class="m-0 mb-5 text-2xl sm:text-3xl">
          Écouter l’épisode
        </h2>
        <div class="grid gap-6">
          {spotifyId && <SpotifyPlayer id={spotifyId} title={title} height={232} />}
          {youtubeId && <YoutubePlayer videoId={youtubeId} title={title} />}
          {youtubeId && youtubeUrl && (
            <p class="m-0">
              <a href={youtubeUrl} target="_blank" rel="noopener noreferrer">
                Ouvrir la vidéo sur YouTube
                <span class="sr-only"> (s’ouvre dans un nouvel onglet)</span>
              </a>
            </p>
          )}
        </div>
      </section>

      <section aria-labelledby="transcription" class="max-w-3xl">
        <h2 id="transcription" class="m-0 mb-5 text-2xl sm:text-3xl">
          Transcription
        </h2>
        {hasTranscript ? (
          <div class="prose">
            <Content />
          </div>
        ) : (
          <p class="m-0">La transcription de cet épisode n’est pas encore disponible.</p>
        )}
      </section>

      {related.length > 0 && (
        <section aria-labelledby="ressources-liees">
          <h2 id="ressources-liees" class="m-0 mb-6 text-2xl sm:text-3xl">
            Les réponses tirées de cet épisode
          </h2>
          <div class="border-b-2 border-black">
            {related.map((resource) => (
              <ResourceItem resource={resource} headingLevel="h3" />
            ))}
          </div>
        </section>
      )}
    </div>
  </article>
</SiteLayout>
