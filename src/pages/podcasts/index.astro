---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";

const episodes = (await getCollection("episodes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<SiteLayout title="Podcasts et vidéos">
  <h1>Podcasts et vidéos</h1>
  {episodes.length ? (
    <ul class="list-none space-y-6 p-0">
      {episodes.map((episode) => (
        <li class="border-b border-slate-200 pb-6">
          <article>
            <h2 class="mt-0">
              <a href={`${import.meta.env.BASE_URL}podcasts/${episode.id}/`}>
                {episode.data.title}
              </a>
            </h2>
            <p>{episode.data.description}</p>
            <p>
              <time datetime={episode.data.pubDate.toISOString()}>
                {episode.data.pubDate.toLocaleDateString("fr-FR", {
                  dateStyle: "long",
                  timeZone: "UTC",
                })}
              </time>
            </p>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <p>Aucun podcast publié pour le moment.</p>
  )}
</SiteLayout>
